# Salin ke pengaturan environment hosting. Semua opsional kecuali yang bertanda (disarankan).
DJANGO_ALLOWED_HOSTS=contoh.domain.id            # (disarankan) pisahkan koma; kosong = semua host
DJANGO_CSRF_TRUSTED_ORIGINS=https://contoh.domain.id   # (wajib bila diakses lewat HTTPS)
DJANGO_SECRET_KEY=                                # kosong = dibuat otomatis & disimpan di samping DB
# Penyimpanan PERSISTEN — arahkan ke volume yang tidak terhapus saat redeploy:
DB_NAME=/data/db.sqlite3
DJANGO_MEDIA_ROOT=/data/media
# Admin awal (dibuat sekali saat start.sh pertama kali):
KREASI_ADMIN_USERNAME=admin
KREASI_ADMIN_PASSWORD=
# Hanya jika diakses lewat HTTP biasa tanpa HTTPS:  DJANGO_HTTPS=0
